  "components": {
    "schemas": {
      "ElectricalHierarchySummary": {
        "properties": {
          "total_zones": {
            "type": "integer",
            "title": "Total Zones",
            "default": 0
          },
          "total_circles": {
            "type": "integer",
            "title": "Total Circles",
            "default": 0
          },
          "total_divisions": {
            "type": "integer",
            "title": "Total Divisions",
            "default": 0
          },
          "total_subdivisions": {
            "type": "integer",
            "title": "Total Subdivisions",
            "default": 0
          },
          "total_substations": {
            "type": "integer",
            "title": "Total Substations",
            "default": 0
          },
          "total_feeders": {
            "type": "integer",
            "title": "Total Feeders",
            "default": 0
          },
          "total_dts": {
            "type": "integer",
            "title": "Total Dts",
            "default": 0
          },
          "total_meters": {
            "type": "integer",
            "title": "Total Meters",
            "default": 0
          },
          "tree": {
            "items": {
              "$ref": "#/components/schemas/HierarchyTreeNode"
            },
            "type": "array",
            "title": "Tree",
            "description": "Hierarchical tree from Zone down to DTs"
          }
        },
        "type": "object",
        "title": "ElectricalHierarchySummary"
      },
      "EnergyReading": {
        "properties": {
          "timestamp": {
            "type": "string",
            "title": "Timestamp",
            "description": "ISO-8601 UTC timestamp of the interval reading"
          },
          "kwh": {
            "type": "number",
            "minimum": 0.0,
            "title": "Kwh",
            "description": "Cumulative active energy reading in kWh"
          },
          "kvah": {
            "type": "number",
            "minimum": 0.0,
            "title": "Kvah",
            "description": "Cumulative apparent energy reading in kVAh"
          },
          "volt_r": {
            "type": "number",
            "minimum": 0.0,
            "title": "Volt R",
            "description": "Phase R voltage in Volts"
          }
        },
        "type": "object",
        "required": [
          "timestamp",
          "kwh",
          "kvah",
          "volt_r"
        ],
        "title": "EnergyReading"
      },
      "GeoCoordinates": {
        "properties": {
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude",
            "description": "Latitude coordinate"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude",
            "description": "Longitude coordinate"
          }
        },
        "type": "object",
        "required": [
          "latitude",
          "longitude"
        ],
        "title": "GeoCoordinates"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Overall health state",
            "default": "healthy"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "upstream_status": {
            "type": "string",
            "title": "Upstream Status",
            "description": "Upstream Urja portal state",
            "default": "connected"
          },
          "cache_freshness": {
            "type": "string",
            "title": "Cache Freshness",
            "description": "Timestamp of last successful upstream synchronization"
          },
          "cache_stale": {
            "type": "boolean",
            "title": "Cache Stale",
            "description": "Whether local cache has expired and needs refresh"
          },
          "meters_cached": {
            "type": "integer",
            "title": "Meters Cached",
            "description": "Number of meters currently in repository"
          },
          "transformers_cached": {
            "type": "integer",
            "title": "Transformers Cached",
            "description": "Number of transformers in repository"
          }
        },
        "type": "object",
        "required": [
          "cache_freshness",
          "cache_stale",
          "meters_cached",
          "transformers_cached"
        ],
        "title": "HealthStatus"
      },
      "HierarchyNode": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Descriptive name of hierarchy entity"
          },
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Unique electrical hierarchy code"
          }
        },
        "type": "object",
        "required": [
          "name",
          "code"
        ],
        "title": "HierarchyNode"
      },
      "HierarchyTreeNode": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Entity name"
          },
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Entity unique code"
          },
          "meter_count": {
            "type": "integer",
            "title": "Meter Count",
            "description": "Total meters connected within this branch",
            "default": 0
          },
          "children": {
            "items": {
              "$ref": "#/components/schemas/HierarchyTreeNode"
            },
            "type": "array",
            "title": "Children",
            "description": "Child nodes in electrical grid"
          }
        },
        "type": "object",
        "required": [
          "name",
          "code"
        ],
        "title": "HierarchyTreeNode"
      },
      "MeterDetail": {
        "properties": {
          "meter_id": {
            "type": "string",
            "title": "Meter Id",
            "description": "Unique meter identifier, e.g., J100000"
          },
          "serial_no": {
            "type": "string",
            "title": "Serial No",
            "description": "Meter hardware serial number, e.g., SE33962"
          },
          "make": {
            "type": "string",
            "title": "Make",
            "description": "Manufacturer brand, e.g., HPL, Genus, Secure"
          },
          "phase_type": {
            "type": "string",
            "title": "Phase Type",
            "description": "Electrical phase type ('single' or 'three')"
          },
          "install_status": {
            "type": "string",
            "title": "Install Status",
            "description": "Current status ('Installed', 'Faulty', 'Decommissioned')"
          },
          "install_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
