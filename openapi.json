          {
            "name": "install_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by installation type ('Whole Current', 'CT Operated')",
              "title": "Install Type"
            },
            "description": "Filter by installation type ('Whole Current', 'CT Operated')"
