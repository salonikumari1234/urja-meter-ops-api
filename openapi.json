              "title": "Dt Code"
            },
            "description": "Filter by Distribution Transformer code (e.g. DT-001)"
          },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Field to sort by (meter_id, serial_no, make, install_status)",
              "default": "meter_id",
              "title": "Sort By"
            },
            "description": "Field to sort by (meter_id, serial_no, make, install_status)"
          },
          {
            "name": "sort_order",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(asc|desc)$",
              "description": "Sort order ('asc' or 'desc')",
              "default": "asc",
              "title": "Sort Order"
            },
            "description": "Sort order ('asc' or 'desc')"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page number (1-indexed)",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number (1-indexed)"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Items per page (max 100)",
              "default": 20,
              "title": "Limit"
            },
            "description": "Items per page (max 100)"
