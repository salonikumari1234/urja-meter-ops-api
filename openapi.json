      "get": {
        "tags": [
          "Health & Diagnostics"
        ],
        "summary": "Health and Readiness Probe",
        "description": "Returns service liveness, upstream connectivity, and cache repository status.",
        "operationId": "get_health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseEnvelope_HealthStatus_"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters": {
