    "/api/v1/meters/{meter_id}/readings": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "Get Meter Interval Readings",
        "description": "Fetch historical 30-minute interval readings including active energy (kWh), apparent energy (kVAh), and Phase R voltage.",
        "operationId": "get_meter_readings_api_v1_meters__meter_id__readings_get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Unique meter identifier",
              "title": "Meter Id"
            },
            "description": "Unique meter identifier"
          },
          {
            "name": "start_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Start date filter (DD/MM/YYYY or ISO-8601)",
              "title": "Start Date"
            },
            "description": "Start date filter (DD/MM/YYYY or ISO-8601)"
          },
          {
            "name": "end_date",
            "in": "query",
            "required": false,
            "schema": {
