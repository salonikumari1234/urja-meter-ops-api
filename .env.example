# Urja Meter Ops Upstream Portal Configuration
UPSTREAM_PORTAL_URL=https://urja-ops.flockenergy.tech
UPSTREAM_USERNAME=your_username_here
UPSTREAM_PASSWORD=your_password_here

# Service API Configuration
API_V1_STR=/api/v1
PROJECT_NAME="Urja Meter Ops API Service"
PORT=8000
HOST=0.0.0.0
DEBUG=False
ENVIRONMENT=development

# Security
API_KEY_SECRET=changeme_in_production_secret_key_12345
API_KEY_HEADER_NAME=X-API-Key

# Upstream Client Settings
UPSTREAM_TIMEOUT_SECONDS=30.0
UPSTREAM_MAX_RETRIES=3
UPSTREAM_RETRY_BACKOFF_FACTOR=0.5

# Cache Settings
CACHE_TTL_METERS_SECONDS=300
CACHE_TTL_LOCATIONS_SECONDS=600
CACHE_TTL_SUMMARY_SECONDS=120
